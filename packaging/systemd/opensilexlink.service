[Unit]
Description=OpenSilexLink USB device server connection manager
Documentation=file:/usr/share/doc/opensilexlink/operations.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=opensilexlink
RuntimeDirectory=opensilexlink
RuntimeDirectoryMode=0750
StateDirectory=opensilexlink
StateDirectoryMode=0700
Environment=XDG_CONFIG_HOME=/var/lib/opensilexlink
Environment=SILEX_SYSTEM_SERVICE=1
Environment=RUST_LOG=info
ExecStart=/usr/bin/silex-daemon --socket /run/opensilexlink/control.sock --escalate none
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
